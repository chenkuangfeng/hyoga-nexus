# 复制为 .env 后填写本地配置；不要提交真实凭据。
NEXUS_ENV=development

# PostgreSQL 连接串；特殊字符需进行 URL 编码。
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:CHANGE_ME@127.0.0.1:5432/nexus

# 仅用于本机开发，API 绑定 127.0.0.1。
NEXUS_AUTH_MODE=development
NEXUS_DEV_USER_ID=local-developer

# 使用模型供应商设置前配置，API 与 worker 必须使用同一 Fernet 主密钥。
# 生成方式见 apps/worker/README.md；不要覆盖已用于加密数据的主密钥。
# NEXUS_CREDENTIAL_ENCRYPTION_KEY=
