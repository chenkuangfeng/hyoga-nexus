    "./api/tenant": "./src/api/tenant/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/locales/embed": "./src/i18n/locales/embed/index.ts",
    "./assets/*": "./src/assets/*"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "tdesign-vue-next": "catalog:",
    "pinia": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:"
  }
