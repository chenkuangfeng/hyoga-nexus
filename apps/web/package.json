{
  "name": "@nexus-web/root",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm dev:workspace",
    "dev:workspace": "corepack pnpm --filter @nexus-web/workspace dev",
    "dev:enterprise": "corepack pnpm --filter @nexus-web/enterprise dev",
    "build": "node scripts/build.mjs",
    "type-check": "node scripts/type-check.mjs",
    "test": "tsx --test --test-concurrency=1 scripts/*.test.* && corepack pnpm --filter @nexus-web/core test && corepack pnpm --filter @nexus-web/workspace test && corepack pnpm --filter @nexus-web/enterprise test",
    "preview": "corepack pnpm --filter @nexus-web/workspace preview",
    "check-i18n": "corepack pnpm --filter @nexus-web/core exec tsx --test src/i18n/localeKeyAudit.test.ts",
    "scan-i18n-gaps": "corepack pnpm --filter @nexus-web/core exec tsx src/i18n/localeGapScan.ts",
    "regenerate-i18n-locales": "corepack pnpm --filter @nexus-web/core exec tsx src/i18n/regeneratePrunedLocales.ts",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:enterprise": "node scripts/run-browser-tests.mjs enterprise",
    "test:browser:workspace": "node scripts/run-browser-tests.mjs workspace",
    "test:browser:install": "playwright install chromium",
    "type-check:browser": "tsc --noEmit -p tsconfig.browser.json",
    "test:browser:preview": "node scripts/run-browser-tests.mjs preview"
  },
  "devDependencies": {
    "@intlify/core-base": "catalog:",
    "@playwright/test": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "esbuild": "catalog:",
    "less": "catalog:",
    "less-loader": "catalog:",
    "npm-run-all2": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "overrides": {
    "lightningcss": "none",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "tdesign-icons-vue-next": "0.4.4"
  },
  "resolutions": {
    "lightningcss": "none",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "tdesign-icons-vue-next": "0.4.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vue-office/pptx",
      "esbuild",
      "vue-demi"
    ],
    "patchedDependencies": {
      "tdesign-vue-next@1.20.10": "patches/tdesign-vue-next@1.20.10.patch"
    }
  }
}
