{
  "name": "@nexus-web/root",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:workspace",
    "dev:workspace": "pnpm --filter @nexus-web/workspace dev",
    "dev:admin": "pnpm --filter @nexus-web/admin dev",
    "build": "pnpm --filter @nexus-web/workspace build && pnpm --filter @nexus-web/admin build",
    "type-check": "pnpm --filter @nexus-web/core type-check && pnpm --filter @nexus-web/workspace type-check && pnpm --filter @nexus-web/admin type-check",
    "test": "tsx --test --test-concurrency=1 scripts/*.test.* && pnpm --filter @nexus-web/core test && pnpm --filter @nexus-web/workspace test",
    "preview": "pnpm --filter @nexus-web/workspace preview",
    "check-i18n": "pnpm --filter @nexus-web/core exec tsx --test src/i18n/localeKeyAudit.test.ts",
    "scan-i18n-gaps": "pnpm --filter @nexus-web/core exec tsx src/i18n/localeGapScan.ts",
    "regenerate-i18n-locales": "pnpm --filter @nexus-web/core exec tsx src/i18n/regeneratePrunedLocales.ts"
  },
  "devDependencies": {
    "@intlify/core-base": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "esbuild": "catalog:",
    "less": "catalog:",
    "less-loader": "catalog:",
    "npm-run-all2": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "overrides": {
    "lightningcss": "none",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "tdesign-icons-vue-next": "0.4.4"
  },
  "resolutions": {
    "lightningcss": "none",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "tdesign-icons-vue-next": "0.4.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vue-office/pptx",
      "esbuild",
      "vue-demi"
    ]
  }
}
